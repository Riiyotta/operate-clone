    {
      "section": "product.ops-steps",
      "variant": "default",
      "content": {
        "heading": "Getting Operational with AI",
        "intro": "Your team brings the relationships and the judgment. We bring everything they need to act on it.",
        "ctaLabel": "Talk to us",
        "ctaHref": "/sign-up",
        "steps": [
          {
            "title": "The Map",
            "headline": "See your pipeline clearly.",
            "description": "We shadow your sales reps and managers to learn how your team sells. Together, we identify friction worth removing and ideas worth playbooking.",
            "label": "clarity",
            "items": [
              "Where deals stall",
              "What wins deals",
              "Where to focus"
            ]
          },
          {
            "title": "The Plan",
            "headline": "Give your team more ways to win.",
            "description": "From CRM updates to follow-ups, we decide together what runs on its own, what goes to an agent, and what stays with your reps.",
            "label": "capacity",
            "items": [
              "More selling time",
              "Broader coverage",
              "Consistent follow-through"
            ]
          },
          {
            "title": "The Build",
            "headline": "Keep every deal moving.",
            "description": "We connect your whole stack (CRM, calls, inbox, and more). Then we bring specialized agents into the deals your team is working, so the right context shows up right when it's needed.",
            "label": "momentum",
            "items": [
              "Prepared for every call",
              "Earlier risk signals",
              "Faster deal progress"
            ]
          },
          {
            "title": "The Rollout",
            "headline": "Watch the results compound.",
            "description": "We stay involved as Operate learns your business, running it against real deals, fixing what's off, and tracking progress with you as coverage grows.",
            "label": "impact",
            "items": [
              "More wins",
              "Stronger adoption",
              "Better retention"
            ]
          }
        ]
      },
      "motion": {
        "pattern": "scroll-active-step",
        "trigger": "scroll",
        "reducedMotionFallback": "instant-state-change",
        "durationMs": 200,
        "easing": "cubic-bezier(.23,1,.32,1)",
        "activeThresholdViewportFraction": 0.5

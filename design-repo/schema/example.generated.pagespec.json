      "variant": "default",
      "content": {
        "heading": "From first call to steady routine",
        "intro": "Dispatchers know the neighborhoods and the customers. The software handles the arithmetic around travel and parts.",
        "ctaLabel": "Plan a pilot",
        "ctaHref": "/sign-up",
        "steps": [
          {
            "title": "Survey",
            "headline": "See the whole week at once.",
            "description": "We sit with your dispatchers for two days and note where schedules slip. Then we agree which recurring problems are worth fixing first.",
            "label": "overview",
            "items": [
              "Where visits slip",
              "Which jobs overrun",
              "Where travel is wasted"
            ]
          },
          {
            "title": "Outline",
            "headline": "Decide who handles what.",
            "description": "Routine rescheduling can run automatically, tricky swaps go to a suggestion list, and sensitive accounts stay with your own coordinators.",
            "label": "balance",
            "items": [
              "Fewer manual swaps",
              "Clear ownership",
              "Calmer mornings"
            ]
          },
          {
            "title": "Connect",
            "headline": "Keep every crew on schedule.",
            "description": "Fieldwork joins the calendars, parts counts and customer notes you already keep. Each crew then sees the changes that matter before leaving the yard.",
            "label": "flow",
            "items": [
              "Parts ready on arrival",
              "Early delay warnings",
              "Shorter drive times"
            ]
          },
          {
            "title": "Settle",
            "headline": "Let the routine take hold.",
            "description": "We check in weekly while the new plan meets real jobs, tune the rules that misfire, and share a simple scorecard as coverage improves.",
            "label": "results",
            "items": [
              "More jobs per day",
              "Happier crews",
              "Fewer callbacks"
            ]
          }
        ]
